{
  "expo": {
    "name": "MiRaffle",
    "slug": "sorteo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icono-miraffle.png",
    "scheme": "sorteoapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/icono-miraffle.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.novabyte0110.sorteoapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "553ef4fe-99bd-48da-b29a-b79b70c0adcb"
      }
    }
  }
}
